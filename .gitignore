# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# The Figma plugin ships its build: a designer importing it into Figma has no
# Node toolchain, and the bare `dist` rule above matches at any depth.
!figma-plugin/dist
!figma-plugin/dist/**
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Types
types

# Credentials for the evaluation harness. Never commit these.
.env
.env.*
!.env.example

# Benchmark output
eval/results/

# Encoded video. `scripts/encode-video.mjs` writes here and the files go to
# the R2 bucket from there; they are output, not source. A re-encode
# replaces every segment at once, which git would keep forever.
docs-site/public/video/
