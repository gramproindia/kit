  "accessibility": {
    "supplied": [
      "the label is a real <label> bound to the textarea",
      "description and error are linked by aria-describedby",
      "aria-invalid while `error` is set",
      "the character counter is announced as a live region when `showCount` is on"
    ],
    "required": [
      "a `label`, or `aria-label` when the field is visually unlabelled",
      "a `maxLength` that matches whatever the server enforces, so the counter does not promise room that does not exist"
    ]
  },
  "composition": {
    "mustNotContain": [
      "label",
      "textarea"
    ],
    "notes": "It renders its own <label> and <textarea>; wrapping it in a second label misbinds the text."
  },
  "operations": {
    "setValue": {
      "summary": "Write a value into the field, as though a person had entered it.",
      "effects": [
        "replaces the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "clear": {
      "summary": "Empty the field.",
      "effects": [
        "discards the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "focus": {
      "summary": "Move keyboard focus to the field.",
      "effects": [
