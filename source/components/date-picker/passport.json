  "accessibility": {
    "supplied": [
      "the calendar is a grid with arrow keys between days, PageUp/PageDown between months, Home and End within a week",
      "the selected and focused days are distinguished for assistive technology, not only by colour",
      "the field accepts typing, so the calendar is never the only way in",
      "Escape closes the calendar and returns focus to the field"
    ],
    "required": [
      "a `label`, or `aria-label` when the field is visually unlabelled",
      "a `locale` matching the user's, since 03/04 is two different days in two places"
    ]
  },
  "composition": {
    "notes": "The calendar renders in the top layer. `presets` are shortcuts into the same value, not a separate control."
  },
  "operations": {
    "setValue": {
      "summary": "Write a value into the field, as though a person had entered it.",
      "effects": [
        "replaces the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "clear": {
      "summary": "Empty the field.",
      "effects": [
        "discards the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "focus": {
      "summary": "Move keyboard focus to the field.",
      "effects": [
        "moves focus"
      ],
      "reversible": false
    },
    "open": {
      "summary": "Open the field's calendar or option list.",
      "effects": [
        "shows the overlay"
      ],
      "reversible": true
    },
    "close": {
      "summary": "Close the field's calendar or option list.",
      "effects": [
        "hides the overlay"
      ],
      "reversible": true
    }
  },
