  "accessibility": {
    "supplied": [
      "the label is a real <label> bound to the input, so clicking it focuses the field",
      "description and error are linked by aria-describedby",
      "aria-invalid while `error` is set",
      "the character counter is a live region when `showCount` is on",
      "OtpInput moves focus between boxes and handles paste of a whole code"
    ],
    "required": [
      "a `label`, or `aria-label` when the field is visually unlabelled",
      "`type` matching the data — email, tel, url — so the right keyboard and autofill appear",
      "`autoComplete` on anything a browser or password manager should fill"
    ]
  },
  "composition": {
    "mustNotContain": [
      "label",
      "input"
    ],
    "notes": "The component renders its own <label> and <input>. Wrapping it in another label binds the text to the wrong control and breaks the click target."
  },
  "operations": {
    "setValue": {
      "summary": "Write a value into the field, as though a person had entered it.",
      "effects": [
        "replaces the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "clear": {
      "summary": "Empty the field.",
      "effects": [
        "discards the field's current value",
        "fires the host's change handler"
      ],
      "reversible": true
    },
    "focus": {
      "summary": "Move keyboard focus to the field.",
      "effects": [
        "moves focus"
      ],
      "reversible": false
    }
  },
