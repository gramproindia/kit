  "accessibility": {
    "supplied": [
      "native <dialog> semantics: the top layer, :modal, and the rest of the page genuinely inert rather than merely covered",
      "focus moves in on open and returns to the trigger on close",
      "Escape closes, unless onBeforeClose refuses",
      "the heading is linked as the dialog's accessible name"
    ],
    "required": [
      "a `description` or a heading — a modal with no name announces as nothing",
      "`initialFocus` when the first focusable element is not the one a user should land on"
    ]
